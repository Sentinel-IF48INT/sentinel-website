# Copy to .env.local and adjust. If DATABASE_URL is omitted, the API routes
# fall back to the in-memory demo seed (dataSource = "demo-seed").
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel

# Secret key for HMAC-SHA256 signed HttpOnly session cookies (use a 32+ char random string in production)
SESSION_SECRET=sentinel-dev-session-secret-change-in-production
